          &lt;img class=&quot;gatsby-resp-image-image&quot; src=&quot;/static/0af8f6236920b26e2e1cd84b5e3bdd3e/d9199/ascension2.png&quot; alt=&quot;angry heavenly official&quot; title=&quot;&quot; loading=&quot;lazy&quot; decoding=&quot;async&quot; style=&quot;width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;&quot;&gt;
